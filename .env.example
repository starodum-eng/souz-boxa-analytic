# === База данных (Neon) ===
# Строка подключения из консоли Neon (Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# === Защита cron-эндпоинта ===
# Vercel Cron автоматически шлёт заголовок Authorization: Bearer $CRON_SECRET
CRON_SECRET="сгенерируйте_длинную_случайную_строку"

# === Яндекс.Директ (Reports API) ===
# OAuth-токен приложения Яндекса с доступом к Директу
YANDEX_DIRECT_TOKEN=""
# Логин клиента (для агентских аккаунтов), опционально
YANDEX_DIRECT_CLIENT_LOGIN=""

# === Яндекс.Метрика (Reporting API) ===
YANDEX_METRIKA_TOKEN=""
YANDEX_METRIKA_COUNTER_ID=""

# === Яндекс.Бизнес ===
YANDEX_BUSINESS_TOKEN=""
YANDEX_BUSINESS_COMPANY_ID=""

# === VK Реклама (ads.vk.com) ===
VK_ADS_ACCESS_TOKEN=""
VK_ADS_ACCOUNT_ID=""

# === Fitbase ===
FITBASE_API_KEY=""
FITBASE_CLUB_ID=""
