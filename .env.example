# === База данных (Neon) ===
# Строка подключения из консоли Neon (Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# === Защита cron-эндпоинта ===
# Vercel Cron автоматически шлёт заголовок Authorization: Bearer $CRON_SECRET
CRON_SECRET="сгенерируйте_длинную_случайную_строку"

# === Общий токен Яндекса ===
# Один OAuth-токен с доступами к Директу, Метрике (и Бизнесу) — достаточно задать
# только его. Отдельные YANDEX_*_TOKEN ниже нужны, лишь если хотите разные токены.
YANDEX_TOKEN=""

# === Яндекс.Директ (Reports API) ===
# Необязательно, если задан YANDEX_TOKEN. Переопределяет общий токен для Директа.
YANDEX_DIRECT_TOKEN=""
# Логин клиента (для агентских аккаунтов), опционально
YANDEX_DIRECT_CLIENT_LOGIN=""

# === Яндекс.Метрика (Reporting API) ===
# Токен необязателен, если задан YANDEX_TOKEN.
YANDEX_METRIKA_TOKEN=""
# Один или несколько счётчиков через запятую (на время перехода: старый,новый).
YANDEX_METRIKA_COUNTER_ID=""
# ID цели-«лида» позиционно к счётчикам, через запятую (у каждого своя цель).
# Метрика → Настройки → Цели → номер цели. Пусто — лиды по этому счётчику = 0.
YANDEX_METRIKA_GOAL_ID=""

# === Яндекс.Бизнес (через отдельный счётчик Метрики карточки организации) ===
# Счётчик Метрики карточки в Яндекс.Бизнесе → отдельный источник «Яндекс.Бизнес».
YANDEX_METRIKA_BUSINESS_COUNTER_ID=""
# Цель «Клик на позвонить» этого счётчика = лиды с карточки (номер цели).
YANDEX_METRIKA_BUSINESS_GOAL_ID=""

# (устаревшее, не используется) прямой API Яндекс.Бизнеса
YANDEX_BUSINESS_TOKEN=""
YANDEX_BUSINESS_COMPANY_ID=""

# === VK Реклама (ads.vk.com) ===
VK_ADS_CLIENT_ID=""
VK_ADS_CLIENT_SECRET=""
VK_ADS_ACCESS_TOKEN=""
VK_ADS_ACCOUNT_ID=""
VK_ADS_USER_ID=""  # id пользователя VK Ads для отзыва токенов при упоре в лимит

# === Callibri (коллтрекинг: звонки + формы + чаты, атрибуция по источникам) ===
# Профиль Callibri → «Получить доступ к API» → email и токен.
CALLIBRI_USER_EMAIL=""
CALLIBRI_USER_TOKEN=""
# ID проекта в Callibri (метод /get_sites). Если один проект — можно оставить пустым.
CALLIBRI_SITE_ID=""
# Необязательно; по умолчанию https://api.callibri.ru
CALLIBRI_BASE_URL=""

# === Fitbase (API v2) ===
# Токен создаётся в CRM. Авторизация: Authorization: Bearer <token> + заголовок domain.
FITBASE_API_KEY=""
# Домен клуба (напр. soyuz-boksa) — уходит в заголовок domain.
FITBASE_DOMAIN=""
# Необязательно; по умолчанию https://api.fitbase.io/api/v2
FITBASE_BASE_URL=""
# Веб-адрес кабинета Fitbase (НЕ API) — для кликабельных ссылок на списки лидов.
# По умолчанию https://soyuz-boksa.fitbase.io
NEXT_PUBLIC_FITBASE_WEB_URL="https://soyuz-boksa.fitbase.io"
# Воронка «Новые лиды» задаётся СПИСКОМ id её ЭТАПОВ (в API v2 нет фильтра по
# воронке и нет справочника воронок — только funnel_step_id). Узнать id этапов:
# SELECT raw->'funnel_step'->>'id', raw->'funnel_step'->>'name', count(*)
#   FROM fitbase_leads GROUP BY 1,2 ORDER BY 3 DESC;
# Пусто → берём ВСЕ лиды (все воронки). Пример для «Новые лиды»: "-1,0,1,2,5,11,20".
FITBASE_LEADS_STEP_IDS=""
# (устарело, игнорируется — API не фильтрует /lead по воронке)
FITBASE_LEADS_FUNNEL_ID="1"
# По умолчанию НЕ считаем повторные заявки с того же телефона (Fitbase is_duplicate).
# Поставь "1", если нужно считать каждую отправку формы отдельно.
FITBASE_LEADS_KEEP_DUPLICATES=""
# Инкрементальный синк: запас перекрытия окна updated_at, часов (по умолч. 48).
FITBASE_SYNC_OVERLAP_HOURS="48"
# Окно визитов (самый «жирный» эндпоинт), дней. Меньше → быстрее синк. По умолч. 45.
# Нужно ≥ 30 для корректного «Удержания» (не ходит 14+ дней) и ≥ длины окна «По дням».
FITBASE_VISITS_DAYS="45"
